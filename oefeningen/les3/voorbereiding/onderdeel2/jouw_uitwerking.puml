@startuml
hide circle

skinparam linetype ortho

rectangle "Shipment aggregate" {
class Shipment <<AR>> {
 +pickup()
 +delivery()
}

class Stop <<Entity>> {
    - arrive()
    - depart()
}

class State <<enum>> <<value object>> {
  InTransit
  Arrived
  Departed
}
}



Shipment "1" -r- "pickup 1" Stop
Shipment "1" -r- "delivery 1" Stop
Stop "1" -r-> "1" State

@enduml